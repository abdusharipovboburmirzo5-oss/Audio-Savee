# Instagram Downloader Bot - Environment Variables
# Copy this file to .env and fill in your values

# ⚠️ HECH QACHON haqiqiy tokenni GitHub yoki ommaviy joyga qo'ymang!

# Bot Token (@BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# Admin Telegram Chat ID (sizning ID)
ADMIN_CHAT_ID=your_telegram_user_id

# Bir nechta admin qo'shish (vergul bilan ajrating)
# ADMIN_IDS=123456789,987654321

# Majburiy kanal
REQUIRED_CHANNEL=@your_channel
CHANNEL_URL=https://t.me/your_channel

# Yuklab olish papkasi
DOWNLOAD_DIR=downloads

# Maksimal fayl hajmi (50MB - Telegram chegarasi)
MAX_FILE_SIZE=50000000

# Standart til (uz/ru/en)
DEFAULT_LANGUAGE=uz

# Health check server porti
PORT=8080
